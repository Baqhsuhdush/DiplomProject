# Local development (without Docker for the API). Copy to backend/.env
DATABASE_URL=postgresql+psycopg://qadam:qadam@localhost:5432/qadam
JWT_SECRET_KEY=replace-with-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
DEBUG=true

# Optional: OpenAI for roadmap generation (otherwise domain templates are used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

REDIS_URL=redis://localhost:6379/0
TELEGRAM_BOT_TOKEN=
REMINDER_INTERVAL_SECONDS=180
WORKER_POLL_SECONDS=60
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TTL_SECONDS=900
# Optional public URL for Telegram inline "Open App" button
TELEGRAM_WEB_APP_URL=
YOUTUBE_API_KEY=
